# Stage 1
FROM node:20-bookworm-slim AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci

# Stage 2
FROM node:20-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_BASE_API_ENDPOINT
ARG NEXT_PUBLIC_USE_MOCK_AUTH
ARG NEXT_PUBLIC_AUTH_LOGIN_ENDPOINT
ARG NEXT_PUBLIC_AUTH_INTROSPECT_ENDPOINT
ARG NEXT_PUBLIC_AUTH_REFRESH_ENDPOINT
ARG NEXT_PUBLIC_AUTH_LOGOUT_ENDPOINT
ARG NEXT_PUBLIC_USERS_ENDPOINT
ARG NEXT_PUBLIC_USER_ME_ENDPOINT
ARG NEXT_PUBLIC_MY_PROFILE_ENDPOINT
ARG NEXT_PUBLIC_MY_PASSWORD_ENDPOINT
ARG NEXT_PUBLIC_MY_SETTINGS_ENDPOINT
ARG NEXT_PUBLIC_MY_AVATAR_ENDPOINT
ARG NEXT_PUBLIC_ADMIN_DEVICES_ENDPOINT
ARG NEXT_PUBLIC_STAFF_DEVICES_ENDPOINT
ARG NEXT_PUBLIC_STAFF_GATES_ENDPOINT
ARG NEXT_PUBLIC_STAFF_GATE_SCAN_ENDPOINT
ARG NEXT_PUBLIC_STAFF_GATE_LOGS_ENDPOINT
ARG NEXT_PUBLIC_ROUTES_ENDPOINT
ARG NEXT_PUBLIC_ADMIN_ROUTES_ENDPOINT
ARG NEXT_PUBLIC_STATIONS_ENDPOINT
ARG NEXT_PUBLIC_ADMIN_STATIONS_ENDPOINT
ARG NEXT_PUBLIC_FARE_CALCULATE_ENDPOINT
ARG NEXT_PUBLIC_ADMIN_FARES_ENDPOINT
ARG NEXT_PUBLIC_TICKET_TYPES_ENDPOINT
ARG NEXT_PUBLIC_ADMIN_TICKET_TYPES_ENDPOINT
ARG NEXT_PUBLIC_ORDERS_ENDPOINT
ARG NEXT_PUBLIC_ORDER_PREVIEW_ENDPOINT
ARG NEXT_PUBLIC_ORDER_STATUS_ENDPOINT
ARG NEXT_PUBLIC_PAYMENTS_ENDPOINT
ARG NEXT_PUBLIC_PAYMENT_INIT_ENDPOINT
ARG NEXT_PUBLIC_PAYMENT_CALLBACK_ENDPOINT
ARG NEXT_PUBLIC_MY_TICKETS_ENDPOINT
ARG NEXT_PUBLIC_PERMISSIONS_MATRIX_ENDPOINT
ARG NEXT_PUBLIC_PERMISSION_ROLES_ENDPOINT
ARG NEXT_PUBLIC_MEDIA_UPLOAD_ENDPOINT

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_BASE_API_ENDPOINT=$NEXT_PUBLIC_BASE_API_ENDPOINT
ENV NEXT_PUBLIC_USE_MOCK_AUTH=$NEXT_PUBLIC_USE_MOCK_AUTH
ENV NEXT_PUBLIC_AUTH_LOGIN_ENDPOINT=$NEXT_PUBLIC_AUTH_LOGIN_ENDPOINT
ENV NEXT_PUBLIC_AUTH_INTROSPECT_ENDPOINT=$NEXT_PUBLIC_AUTH_INTROSPECT_ENDPOINT
ENV NEXT_PUBLIC_AUTH_REFRESH_ENDPOINT=$NEXT_PUBLIC_AUTH_REFRESH_ENDPOINT
ENV NEXT_PUBLIC_AUTH_LOGOUT_ENDPOINT=$NEXT_PUBLIC_AUTH_LOGOUT_ENDPOINT
ENV NEXT_PUBLIC_USERS_ENDPOINT=$NEXT_PUBLIC_USERS_ENDPOINT
ENV NEXT_PUBLIC_USER_ME_ENDPOINT=$NEXT_PUBLIC_USER_ME_ENDPOINT
ENV NEXT_PUBLIC_MY_PROFILE_ENDPOINT=$NEXT_PUBLIC_MY_PROFILE_ENDPOINT
ENV NEXT_PUBLIC_MY_PASSWORD_ENDPOINT=$NEXT_PUBLIC_MY_PASSWORD_ENDPOINT
ENV NEXT_PUBLIC_MY_SETTINGS_ENDPOINT=$NEXT_PUBLIC_MY_SETTINGS_ENDPOINT
ENV NEXT_PUBLIC_MY_AVATAR_ENDPOINT=$NEXT_PUBLIC_MY_AVATAR_ENDPOINT
ENV NEXT_PUBLIC_ADMIN_DEVICES_ENDPOINT=$NEXT_PUBLIC_ADMIN_DEVICES_ENDPOINT
ENV NEXT_PUBLIC_STAFF_DEVICES_ENDPOINT=$NEXT_PUBLIC_STAFF_DEVICES_ENDPOINT
ENV NEXT_PUBLIC_STAFF_GATES_ENDPOINT=$NEXT_PUBLIC_STAFF_GATES_ENDPOINT
ENV NEXT_PUBLIC_STAFF_GATE_SCAN_ENDPOINT=$NEXT_PUBLIC_STAFF_GATE_SCAN_ENDPOINT
ENV NEXT_PUBLIC_STAFF_GATE_LOGS_ENDPOINT=$NEXT_PUBLIC_STAFF_GATE_LOGS_ENDPOINT
ENV NEXT_PUBLIC_ROUTES_ENDPOINT=$NEXT_PUBLIC_ROUTES_ENDPOINT
ENV NEXT_PUBLIC_ADMIN_ROUTES_ENDPOINT=$NEXT_PUBLIC_ADMIN_ROUTES_ENDPOINT
ENV NEXT_PUBLIC_STATIONS_ENDPOINT=$NEXT_PUBLIC_STATIONS_ENDPOINT
ENV NEXT_PUBLIC_ADMIN_STATIONS_ENDPOINT=$NEXT_PUBLIC_ADMIN_STATIONS_ENDPOINT
ENV NEXT_PUBLIC_FARE_CALCULATE_ENDPOINT=$NEXT_PUBLIC_FARE_CALCULATE_ENDPOINT
ENV NEXT_PUBLIC_ADMIN_FARES_ENDPOINT=$NEXT_PUBLIC_ADMIN_FARES_ENDPOINT
ENV NEXT_PUBLIC_TICKET_TYPES_ENDPOINT=$NEXT_PUBLIC_TICKET_TYPES_ENDPOINT
ENV NEXT_PUBLIC_ADMIN_TICKET_TYPES_ENDPOINT=$NEXT_PUBLIC_ADMIN_TICKET_TYPES_ENDPOINT
ENV NEXT_PUBLIC_ORDERS_ENDPOINT=$NEXT_PUBLIC_ORDERS_ENDPOINT
ENV NEXT_PUBLIC_ORDER_PREVIEW_ENDPOINT=$NEXT_PUBLIC_ORDER_PREVIEW_ENDPOINT
ENV NEXT_PUBLIC_ORDER_STATUS_ENDPOINT=$NEXT_PUBLIC_ORDER_STATUS_ENDPOINT
ENV NEXT_PUBLIC_PAYMENTS_ENDPOINT=$NEXT_PUBLIC_PAYMENTS_ENDPOINT
ENV NEXT_PUBLIC_PAYMENT_INIT_ENDPOINT=$NEXT_PUBLIC_PAYMENT_INIT_ENDPOINT
ENV NEXT_PUBLIC_PAYMENT_CALLBACK_ENDPOINT=$NEXT_PUBLIC_PAYMENT_CALLBACK_ENDPOINT
ENV NEXT_PUBLIC_MY_TICKETS_ENDPOINT=$NEXT_PUBLIC_MY_TICKETS_ENDPOINT
ENV NEXT_PUBLIC_PERMISSIONS_MATRIX_ENDPOINT=$NEXT_PUBLIC_PERMISSIONS_MATRIX_ENDPOINT
ENV NEXT_PUBLIC_PERMISSION_ROLES_ENDPOINT=$NEXT_PUBLIC_PERMISSION_ROLES_ENDPOINT
ENV NEXT_PUBLIC_MEDIA_UPLOAD_ENDPOINT=$NEXT_PUBLIC_MEDIA_UPLOAD_ENDPOINT

RUN npm run build

# Stage 3
FROM node:20-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

EXPOSE 3000

USER node

CMD ["node", "server.js"]
