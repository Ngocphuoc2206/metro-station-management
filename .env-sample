# =====================================================
# MetroNext Frontend — Environment Variables Sample
# =====================================================
# Sao chép file này thành .env.local và điền giá trị thực
# cp .env-sample .env.local
# =====================================================

# ----------------------------------------------------
# API Configuration
# ----------------------------------------------------

# URL gốc của Backend API (không có dấu / ở cuối)
# Development:  http://localhost:8080/api/v1
# Production:   https://api.metronext.vn/api/v1
NEXT_PUBLIC_BASE_API_ENDPOINT=http://localhost:8080/api/v1

# ----------------------------------------------------
# Mock / Dev Mode
# ----------------------------------------------------

# Bật mock auth khi Backend chưa sẵn sàng (true | false)
# true  → login bằng admin@test.vn / staff@test.vn / passenger@test.vn
# false → gọi API thật tại NEXT_PUBLIC_BASE_API_ENDPOINT
NEXT_PUBLIC_USE_MOCK_AUTH=true

# ----------------------------------------------------
# OAuth / Redirect (nếu dùng)
# ----------------------------------------------------

# URI redirect sau khi đăng nhập OAuth
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/auth/login
